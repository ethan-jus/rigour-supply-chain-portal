# 浏览器只请求相对路径；Vite开发服务器将/api代理到下面的Gateway地址。
# 换服务器时在.env.local覆盖，不要把服务器IP写入vite.config.ts。
VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=local
VITE_API_TARGET=http://localhost:26880
# 本机开发的IAM固定使用loopback；通过局域网IP打开门户时，IAM CORS按私网网段动态放行。
# OIDC回调地址必须与IAM已注册客户端完全一致，不能随意改成通配符。
VITE_OIDC_ISSUER=http://localhost:26881
VITE_OIDC_CLIENT_ID=rigour-portal-browser
VITE_OIDC_REDIRECT_URI=http://localhost:5100/oidc/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5100/
# 本机开发时若门户通过局域网IP打开，代码会把localhost:5200替换为当前页面主机名。
# 生产请配置HTTPS地址，不要使用任意HTTP IP。
VITE_FEISHU_SALES_WORKBENCH_URL=http://localhost:5200/#/home
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
